# Copiez ce fichier en `.env` puis renseignez la chaîne de connexion Neon
# (Neon Dashboard → Connect → Connection string → Pooled connection).
DATABASE_URL="postgresql://<utilisateur>:<mot-de-passe>@<host>.neon.tech/neondb?sslmode=require"

# Secret de signature des sessions (JWT HS256). Générer avec :
#   node -e "console.log(require('node:crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET="changez-moi-en-production"

# Optionnel : port du serveur API Node (défaut 3001)
# API_PORT=3001

# Optionnel : n'accepter le cookie de session que sur HTTPS (production)
# COOKIE_SECURE=true

# Optionnel : ré-autoriser la création publique d'un compte ADMIN
# (désactivé par défaut dès qu'un administrateur existe)
# ALLOW_PUBLIC_ADMIN_SIGNUP=true

# Optionnel : URL de l'API utilisée par `scripts/smoke.ts` (défaut http://localhost:3001)
# API_URL=http://localhost:3001
